{
  "name": "komascope",
  "version": "0.2.3",
  "description": "An open-source lightweight comic reader optimized for 4K displays",
  "main": "./out/main/index.js",
  "author": "KomaScope contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:dir": "electron-vite build && electron-builder --dir --publish never",
    "icon": "python scripts/generate-logo-icon.py",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide": "^1.28.0"
  }
}
